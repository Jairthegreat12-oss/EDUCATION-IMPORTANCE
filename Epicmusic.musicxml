      <direction placement="above"><direction-type><metronome><beat-unit>quarter</beat-unit><per-minute>75</per-minute></metronome></direction-type><direction-type><words default-y="40" font-weight="bold">Maestoso</words></direction-type><sound tempo="75"/></direction>
